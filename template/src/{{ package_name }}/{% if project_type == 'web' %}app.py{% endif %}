"""{{ project_name }} Web 应用（FastAPI）."""

from __future__ import annotations

from fastapi import FastAPI

app = FastAPI(title="{{ project_name }}", description="{{ description }}")


@app.get("/")
def read_root() -> dict[str, str]:
    """根路径健康检查."""
    return {"status": "ok", "project": "{{ package_name }}"}


if __name__ == "__main__":
    import os

    import uvicorn

    # 默认只监听回环地址、关闭 reload，避免开发配置直接暴露到公网；
    # 需要对外暴露时用环境变量覆盖：UVICORN_HOST=0.0.0.0 UVICORN_RELOAD=1
    uvicorn.run(
        "{{ package_name }}.app:app",
        host=os.getenv("UVICORN_HOST", "127.0.0.1"),
        port=int(os.getenv("UVICORN_PORT", "8000")),
        reload=os.getenv("UVICORN_RELOAD", "0") == "1",
    )
