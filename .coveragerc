[run]
branch = true
# 测试用 pytest-xdist 多进程并行，concurrency 必须是 multiprocessing；
# 设为 thread 会导致各 worker 的覆盖率无法正确合并（实测统计从 96% 掉到 74%）
concurrency = multiprocessing
omit = tests/*
source = coopie

[report]
fail_under = 95
exclude_lines =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    pragma: no cover
    raise NotImplementedError
show_missing = true
